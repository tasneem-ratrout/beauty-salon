	<subDataset name="tableDataset" uuid="38c88a69-ef13-44ea-89ed-7ba9ee13e4fb">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
		<queryString language="SQL">
			<![CDATA[SELECT COUNT(customer.username)  AS customer_count,
	employees.employee_username
FROM customer
	INNER JOIN employees ON 
	 employees.employee_username = customer.username 
GROUP BY employees.employee_username]]>
		</queryString>
		<field name="customer_count" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="customer_count"/>
