	<subDataset name="tableDataset" uuid="72593215-d1e3-4100-9262-aa49ff75ad41">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
		<queryString language="SQL">
			<![CDATA[-- عرض الموظفين مع رواتبهم
SELECT 
    employee_username,
    position,
    salary
FROM 
    employees

UNION ALL

-- عرض مجموع الرواتب لجميع الموظفين
SELECT 
    'Total Salaries' AS employee_username,
    'N/A' AS position,
    SUM(salary) AS salary
FROM 
    employees]]>
		</queryString>
		<field name="employee_username" class="java.lang.String">
